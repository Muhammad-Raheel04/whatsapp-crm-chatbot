generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String @db.Text
  
  sessions Sessions[]

  createdAt DateTime @default(now())
}

model Sessions {
  id           Int    @id @default(autoincrement())
  refreshToken String @unique @db.Text

  user_id Int
  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Contact {
  id   Int     @id @default(autoincrement())
  waId String  @unique
  name String?

  message Message[]

  createdAt DateTime @default(now())
}

model Message {
  id          Int    @id @default(autoincrement())
  waMessageId String? @unique

  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])

  type     String
  body     String?
  mimeType String?

  direction MessageDirection
  status    MessageStatus    @default(RECEIVED)

  createdAt DateTime @default(now())
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  PROCESSED
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
  PROCESSING
  PENDING
}

model Settings{
  id Int @id @default(1)
  responseDelay Int @default(5)
  metaWhatsAppToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}