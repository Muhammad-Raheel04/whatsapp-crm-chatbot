generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String @db.Text

  sessions Sessions[]

  createdAt DateTime @default(now())
}

model Sessions {
  id           Int    @id @default(autoincrement())
  refreshToken String @unique @db.Text

  user_id Int
  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Contact {
  id   Int     @id @default(autoincrement())
  waId String  @unique
  name String?

  groups GroupContact[]

  message Message[]

  createdAt DateTime @default(now())
}

model Groups {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?
  prompt      String? @db.Text
  aiEnabled   Boolean @default(true)

  contacts GroupContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GroupContact {
  contactId Int
  groupId   Int

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group   Groups  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([contactId, groupId])
  @@index([groupId])
}

model Message {
  id          Int     @id @default(autoincrement())
  waMessageId String? @unique

  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id])

  type     String
  body     String?
  mimeType String?

  direction MessageDirection
  status    MessageStatus    @default(RECEIVED)

  createdAt DateTime @default(now())
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  PROCESSED
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
  PROCESSING
  PENDING
}

model Settings {
  id                Int     @id @default(1)
  responseDelay     Int     @default(5)
  metaWhatsAppToken String?
  systemPrompt      String?
  aiEnabled         Boolean @default(true)

  groqOpenAiKey String?
  groqApiKey    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  keywords ProductKeyword[]
  media    ProductMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductKeyword {
  id      Int    @id @default(autoincrement())
  keyword String

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductMedia {
  id   Int       @id @default(autoincrement())
  type MediaType

  filePath String

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}
